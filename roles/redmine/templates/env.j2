# OpenTelemetry Configuration
OTEL_SERVICE_NAME={{ redmine_otel_config.service_name }}
OTEL_SERVICE_VERSION={{ redmine_otel_config.service_version }}
OTEL_RESOURCE_ATTRIBUTES=service.name={{ redmine_otel_config.service_name }},service.version={{ redmine_otel_config.service_version }},deployment.environment=production

# Collector local endpoint
OTEL_EXPORTER_OTLP_ENDPOINT={{ redmine_otel_config.collector_endpoint }}
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Configuración de exporters
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# Configuración de sampling
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0